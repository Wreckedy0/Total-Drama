            notify("Character not found!")
            return
        end

        local idols = workspace:FindFirstChild("Idols")

        if not idols then
            notify("Idols folder not found!")
            return
        end

        local found = 0

        for _, v in ipairs(idols:GetDescendants()) do
            if v.Name == "Bag" or v.Name == "SafetyStatue" then
                local hit = v:FindFirstChild("hit")

                if hit and hit:IsA("BasePart") then
                    hit.Transparency = 1
                    hit.CanCollide = false

