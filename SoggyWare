Tabs.Main:AddButton({
    Title = "Find Statue",
    Description = "Find Statue And Bag.",

    Callback = function()
        local character = player.Character

        local torso = character and (
            character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
        )

