local usernameEnabled = false
local usernameGui = Instance.new("ScreenGui")
usernameGui.Name = "SoggyWareUsernames"
usernameGui.ResetOnSpawn = false
local pg = player:WaitForChild("PlayerGui")
local oldGui = pg:FindFirstChild("SoggyWareUsernames")
if oldGui then oldGui:Destroy() end
usernameGui.Parent = pg

local function updateNameTag(target)
    local tagName = "User_" .. target.UserId
    local oldTag = usernameGui:FindFirstChild(tagName)
    if oldTag then oldTag:Destroy() end
    if not usernameEnabled or target == player then return end
    local character = target.Character
    local head = character and character:FindFirstChild("Head")
    if not head then return end

    local tag = Instance.new("BillboardGui")
    tag.Name = tagName
    tag.Adornee = head
    tag.Size = UDim2.fromOffset(200, 30)
    tag.StudsOffsetWorldSpace = Vector3.new(0, 1.3, 0)
    tag.MaxDistance = 150
    tag.AlwaysOnTop = false
    tag.Parent = usernameGui

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = target.Name
    label.TextColor3 = Color3.fromRGB(255, 0, 0)
    label.TextStrokeColor3 = Color3.fromRGB(80, 0, 0)
    label.TextStrokeTransparency = 0.25
    label.Font = Enum.Font.ArialBold
    label.TextSize = 14
    label.Parent = tag
end

local function watchPlayer(target)
    if target == player then return end
    target.CharacterAdded:Connect(function(character)
        character:WaitForChild("Head", 10)
        updateNameTag(target)
    end)
    updateNameTag(target)
end

for _, target in ipairs(Players:GetPlayers()) do
    watchPlayer(target)
end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function(target)
