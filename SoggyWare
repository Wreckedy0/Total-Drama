-- MATH MANIA
-- =====================================
local mathManiaStarted = false
local mathManiaConnection

local function solveMathMania(gui)
    if gui.Name ~= "MathMania" and gui.Name ~= "GUI" then return end
    task.spawn(function()
        for attempt = 1, 30 do
            if not mathManiaStarted or not gui.Parent then return end
            for i = 1, 10 do
                local question = gui:FindFirstChild(tostring(i))
                if question then
                    local mainText = question:FindFirstChild("MainText")
                    local box = question:FindFirstChild("Box")
                    if mainText and box and mainText:IsA("TextLabel") and box:IsA("TextBox") then
                        local a, op, b = mainText.Text:match("^%s*(-?%d+)%s*([%+%-])%s*(-?%d+)")
                        a, b = tonumber(a), tonumber(b)
                        if a and b then
                            box.Text = tostring(op == "+" and a + b or a - b)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

Tabs.Main:AddButton({
    Title = "Math Mania",
    Description = "Automatically fill Math Mania answers",
    Callback = function()
        if mathManiaStarted then
            notify("Math Mania is already enabled!")
            return
        end
        mathManiaStarted = true
        local playerGui = player:WaitForChild("PlayerGui")
        mathManiaConnection = playerGui.ChildAdded:Connect(solveMathMania)
        for _, gui in ipairs(playerGui:GetChildren()) do
            solveMathMania(gui)
        end
        notify("Math Mania enabled!")
    end
})

